      "typeVersion": 4.2,
      "position": [
        1200,
        700
      ],
      "parameters": {
        "method": "GET",
        "url": "https://tsvmouanmvhbhwwwqtdt.supabase.co/rest/v1/agreements_full",
        "options": {
          "timeout": 60000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
