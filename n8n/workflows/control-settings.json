        "url": "https://tsvmouanmvhbhwwwqtdt.supabase.co/rest/v1/update_settings",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "pipeline",
              "value": "=eq.{{ $json.pipeline }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.patch) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "TtSupabaseSecret",
          "name": "Supabase secret key (trade-tracker)"
        }
      },
      "notes": "更新 update_settings",
      "notesInFlow": true
    },
    {
      "id": "24f9bde6-b712-5de7-8d4f-e9211add6da2",
