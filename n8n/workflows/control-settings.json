      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 只接受兩種流程與 true/false,其他內容一律拒絕\nconst body = $input.first().json.body ?? {};\nconst pipeline = body.pipeline;\nconst enabled = body.auto_enabled;\nif (!['database', 'news'].includes(pipeline) || typeof enabled !== 'boolean') {\n  throw new Error('pipeline 必須是 database 或 news,auto_enabled 必須是 true 或 false');\n}\nreturn [{ json: { pipeline, patch: { auto_enabled: enabled, updated_by: 'web' } } }];"
      },
      "notes": "只接受合法的值",
      "notesInFlow": true
    },
    {
      "id": "c8bda10a-3084-537b-9ae0-1494b27704a7",
