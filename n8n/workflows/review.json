              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.patch) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "TtSupabaseSecret",
          "name": "Supabase secret key (trade-tracker)"
        }
      },
      "alwaysOutputData": true,
      "notes": "待確認 → 顯示或撤回",
      "notesInFlow": true
    },
