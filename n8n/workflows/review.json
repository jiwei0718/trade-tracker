      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 只接受事件 id 清單與「採用/不採用」;只改仍在待確認的事件\nconst body = $input.first().json.body ?? {};\nconst ids = Array.isArray(body.ids) ? body.ids.map(Number).filter((n) => Number.isInteger(n) && n > 0) : [];\nif (!ids.length || ids.length > 100 || !['approve', 'reject'].includes(body.decision)) {\n  throw new Error('ids 必須是 1–100 個事件 id,decision 必須是 approve 或 reject');\n}\nreturn [{ json: { filter: `in.(${ids.join(',')})`, patch: { status: body.decision === 'approve' ? 'active' : 'retracted' } } }];"
      },
      "notes": "只接受合法的值",
      "notesInFlow": true
    },
    {
      "id": "8d9f47ec-9d9a-54a2-b656-03b4186e7526",
